<?xml version="1.0"?>
<package format="2">
  <name>planner_common</name>
  <version>1.0.0</version>
  <description>Shared planning parameters, sampling, trajectory, and constraint utilities for SubtPlanner.</description>

  <maintainer email="ggh@subtplanner.dev">SubtPlanner Developers</maintainer>

  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <buildtool_depend>catkin_simple</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf</depend>

</package>
