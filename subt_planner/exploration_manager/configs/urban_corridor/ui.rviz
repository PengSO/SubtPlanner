Panels:
- Class: rviz/Displays
  Help Height: 0
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /ExplorationViz1
    - /Sensors1
    - /Voxblox1
    Splitter Ratio: 0.35
  Tree Height: 420
- Class: subt_planner_rviz_panel/SubtPlanner Exploration Panel
  Name: Task Control Pane
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 1
