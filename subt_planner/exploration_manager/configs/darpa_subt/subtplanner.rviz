Panels:
- Class: rviz/Displays
  Help Height: 0
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Sensors1
    - /Cognitive Map1
    - /Local Exploration1
    - /Global Repositioning1
